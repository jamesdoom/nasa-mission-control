{
  "name": "nasa-mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev -w @mission-control/server\" \"npm:dev -w @mission-control/client\"",
    "build": "npm run build -w @mission-control/shared && npm run build -w @mission-control/server && npm run build -w @mission-control/client",
    "start": "node apps/server/dist/index.js",
    "typecheck": "npm run typecheck -w @mission-control/shared && npm run typecheck -w @mission-control/server && npm run typecheck -w @mission-control/client && tsc -p tsconfig.json --pretty false",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.62.0",
    "axe-core": "^4.12.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
